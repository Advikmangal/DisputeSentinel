# Backend settings. Copy to .env at the repository root. Never commit real values.
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=replace-with-gemini-api-key
DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/disputesentinel
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Webhook and evidence analysis settings.
PAYPAL_WEBHOOK_ID=replace-with-sandbox-webhook-id
GEMINI_MODEL=replace-with-supported-gemini-model
# fixture creates labeled simulated disputes; paypal syncs matched Sandbox disputes.
DISPUTE_SOURCE=fixture
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# Empty uses Vite's local /api proxy. On Render set the backend HTTPS origin (no /api).
VITE_API_URL=
# Production startup seeds this merchant only if absent; scripts also use these settings.
# No default password. Supply real values through the environment, never tracked files.
DEMO_MERCHANT_EMAIL=replace-with-demo-email
DEMO_MERCHANT_PASSWORD=replace-with-strong-demo-password
# Checkout obtains its public client ID from the authenticated backend.
# Render runtime version.
PYTHON_VERSION=3.12.11

