      "Authorization": "Bearer <JWT_PLACEHOLDER>",
      "Content-Type": "application/json"
    },
    "body": {
      "order_id": "SANDBOX-ORDER-EXAMPLE"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "id": 1,
      "merchant_id": 1,
      "paypal_order_id": "SANDBOX-ORDER-EXAMPLE",
